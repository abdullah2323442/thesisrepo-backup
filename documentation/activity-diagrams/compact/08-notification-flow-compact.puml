@startuml Notification_Flow_Compact
!theme plain
title Notification System Flow
skinparam activityFontSize 10
skinparam noteFontSize 9
skinparam defaultFontSize 10
skinparam activity {
  BackgroundColor #E0F2F1
  BorderColor #00796B
}

start

:Event Occurs;
note right
• Report Assigned
• Status Changed
• Meeting Scheduled
• Feedback Available
end note

:Identify Recipients;

split
  :Database;
  :Store Notification;
split again
  :Email;
  if (Enabled?) then (Yes)
    :Send Email;
  endif
split again
  :Real-time;
  if (Online?) then (Yes)
    :Push Update;
  endif
end split

:User Sees Notification;
:Click to View;
:Mark as Read;

stop

@enduml